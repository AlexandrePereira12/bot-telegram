# =============================================================================
# Copie para .env e preencha. NUNCA commite o .env preenchido.
#
# Gerar segredos:
#   JWT_SECRET=$(openssl rand -hex 32)
#   ENCRYPTION_KEY=$(openssl rand -hex 32)
#   TELEGRAM_WEBHOOK_SECRET=$(openssl rand -hex 32)
#   CONVERSION_WEBHOOK_SECRET=$(openssl rand -hex 32)
# =============================================================================

# --- Identidade da empresa (configuração/identificação, NUNCA controle de acesso)
COMPANY_NAME=Empresa Teste
COMPANY_SLUG=empresa-teste

# --- Ambiente: development | staging | production
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Telegram
# Token do BotFather. Em dev use um bot de teste dedicado.
TELEGRAM_BOT_TOKEN=
# false = polling (dev local, nao exige HTTPS publico)
# true  = webhook (producao; exige API_DOMAIN acessivel por HTTPS)
TELEGRAM_USE_WEBHOOK=false
# Obrigatorio quando TELEGRAM_USE_WEBHOOK=true. Validado no header
# X-Telegram-Bot-Api-Secret-Token de cada update recebido.
TELEGRAM_WEBHOOK_SECRET=

# --- PostgreSQL
POSTGRES_USER=traffic
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=traffic_bot
DATABASE_URL=postgresql+asyncpg://traffic:change-me-local-only@postgres:5432/traffic_bot

# --- Redis
REDIS_URL=redis://redis:6379/0

# --- Seguranca da API
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- Webhooks externos de conversao (HMAC-SHA256 sobre timestamp.body)
CONVERSION_WEBHOOK_SECRET=
# Janela de tolerancia do X-Timestamp, em segundos (anti-replay)
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Portas no host
# Porta publica do Nginx (use outra se a 80 estiver ocupada).
NGINX_PORT=80
# Porta da API no loopback, para debug local. Precisa ser unica por empresa
# quando houver mais de um deployment no mesmo servidor.
API_LOCAL_PORT=8000

# --- Dominios
API_DOMAIN=localhost
WEB_DOMAIN=localhost
# Origens permitidas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- Rate limiting (por janela deslizante no Redis)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_TELEGRAM_PER_MINUTE=30

# --- Midia (imagens, videos e audios das mensagens)
# Os arquivos ficam no PostgreSQL, em `media_objects`. MEDIA_ROOT e legado:
# so a migration 0007 o usa, para importar a midia que vivia no volume.
MEDIA_ROOT=/app/media
# Teto por arquivo. 20MB e o limite de download do bot no Telegram.
MAX_MEDIA_MB=20

# --- Funil
CONSENT_VERSION=1
MIN_AGE=18
FOLLOWUP_DELAY_MINUTES=60

# --- Integracoes externas (opcional; se vazio, nada e enviado)
# Porta do n8n no loopback (perfil `integrations`); unica por empresa.
N8N_LOCAL_PORT=5678
N8N_WEBHOOK_URL=

# --- Frontend (build-time do Vite)
# VAZIO no deploy com Docker: o dashboard chama /api/v1/... na propria origem
# e o Nginx faz o proxy. Apontar para outra porta faria o browser furar o
# Nginx e esbarrar no CORS.
# Preencha SOMENTE para rodar `npm run dev` fora do Docker (Vite na 5173),
# com a URL publica da API — ex.: http://localhost:8090
VITE_API_BASE_URL=

# --- Atendimento por IA (antes da fila humana)
# A CHAVE DE API NAO FICA AQUI: ela e cadastrada em Configuracoes no painel
# (perfil ADMIN) e guardada cifrada no banco. Sem integracao ativa, o
# atendimento por IA nao existe e o lead vai direto para a fila humana.
# O que segue sao limites operacionais e os enderecos dos provedores.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Espera maxima pela resposta. Estourou, o lead vai para a fila humana.
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=800
# Mensagens anteriores enviadas como contexto a cada chamada.
AI_HISTORY_MESSAGES=12
# Pedidos de atendente humano, dentro do atendimento por IA, ate escalar.
AI_ESCALATE_AFTER_REQUESTS=2
